{
  "entities": {
    "UserSchedules": {
      "title": "UserSchedules",
      "description": "User's synchronized schedule data.",
      "type": "object",
      "properties": {
        "logs": {
          "type": "object",
          "description": "Daily logs for the user."
        },
        "midCounts": {
          "type": "object",
          "description": "Mid-shift counts for the user."
        },
        "fmlaCases": {
          "type": "array",
          "description": "List of FMLA cases."
        },
        "cardPrefs": {
          "type": "object",
          "description": "Preferences for cards."
        },
        "settings": {
          "type": "object",
          "description": "Settings for the schedule tracker."
        },
        "lockedMonths": {
          "type": "array",
          "description": "List of locked month strings."
        },
        "deletedShiftIds": {
          "type": "object",
          "description": "Tombstone map of deleted shift IDs to deletion timestamps."
        },
        "deletedShiftKeys": {
          "type": "object",
          "description": "Tombstone map of deleted shift content keys (date|type|hrs|otRule|label|fmlaCase) to deletion timestamps."
        },
        "schemaVersion": {
          "type": "number",
          "description": "Minimum required client schema version (>= 3) to block stale cached app versions."
        },
        "rev": {
          "type": "number",
          "description": "Monotonically increasing document revision number incremented by 1 on each write."
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserSchedules"
      },
      "description": "Private application state for a user."
    }
  }
}

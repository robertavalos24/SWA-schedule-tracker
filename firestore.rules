rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isNum(val) {
      return val is int || val is float || val is number;
    }

    function existingRev() {
      return (resource != null && isNum(resource.data.get('rev', 0)) && resource.data.get('rev', 0) >= 0)
        ? resource.data.get('rev', 0)
        : 0;
    }

    // Each user can only read and write their own document, and writes must have schemaVersion >= 3 and incremented rev
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isNum(request.resource.data.get('schemaVersion', null))
        && request.resource.data.get('schemaVersion', 0) >= 3
        && isNum(request.resource.data.get('rev', null))
        && (
          resource == null
          || request.resource.data.get('rev', 0) == existingRev() + 1
        );
      allow delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function isSignedIn() { return request.auth != null; }

    function isValidUserSchedules(data) {
      return (!('logs' in data) || (data.logs is map))
             && (!('midCounts' in data) || (data.midCounts is map))
             && (!('fmlaCases' in data) || (data.fmlaCases is list && data.fmlaCases.size() <= 200))
             && (!('cardPrefs' in data) || (data.cardPrefs is map))
             && (!('settings' in data) || (data.settings is map))
             && (!('lockedMonths' in data) || (data.lockedMonths is list && data.lockedMonths.size() <= 500));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create, update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserSchedules(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
